* {
    bg: #1e1e2e;
    bg-alt: #313244;
    fg: #cdd6f4;
    fg-alt: #a6adc8;

    mauve: #cba6f7;
    blue: #89b4fa;
    surface: #45475a;
    red: #f38ba8;

    background-color: @bg;
    text-color: @fg;
}

window {
    width: 600px;
    border: 2px;
    border-color: @mauve;

    background-color: @bg;
    padding: 20px;
}

mainbox {
    background-color: transparent;
    spacing: 15px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 10px 14px;
    spacing: 10px;

    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @mauve;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search...";
    placeholder-color: @fg-alt;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    spacing: 5px;
    fixed-height: false;
}

element {
    background-color: transparent;
    border-radius: 6px;
    padding: 8px 12px;
}

element normal {
    background-color: transparent;
    text-color: @fg;
}

element selected {
    background-color: @bg-alt;
    text-color: @mauve;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

element-icon {
    background-color: transparent;
    size: 24px;
}